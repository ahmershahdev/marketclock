        "properties": {
          "cycle": {
            "title": "Cycle",
            "type": "integer"
          },
          "markets": {
            "items": {
              "type": "string"
            },
            "title": "Markets",
            "type": "array"
          },
          "settlement_date": {
            "format": "date",
            "title": "Settlement Date",
            "type": "string"
          },
          "trade_date": {
            "format": "date",
            "title": "Trade Date",
            "type": "string"
          },
