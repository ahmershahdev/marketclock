    "/api/v1/overlap": {
      "get": {
        "operationId": "getOverlap",
        "parameters": [
          {
            "in": "query",
            "name": "markets",
            "required": true,
            "schema": {
              "description": "Comma-separated MICs, such as XNYS,XLON",
              "title": "Markets",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "start",
            "required": true,
            "schema": {
              "format": "date",
              "title": "Start",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "end",
            "required": true,
            "schema": {
              "format": "date",
