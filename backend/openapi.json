            "description": "Invalid parameter"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown market"
          }
        },
        "summary": "Days from start to end on which every market trades, at most 400 days"
      }
    },
