  "info": {
    "title": "MarketClock API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/add-trading-days": {
      "get": {
        "operationId": "addTradingDays",
        "parameters": [
          {
            "in": "query",
            "name": "markets",
            "required": true,
            "schema": {
              "description": "Comma-separated MICs, such as XNYS,XLON",
              "title": "Markets",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "date",
            "required": true,
            "schema": {
              "format": "date",
              "title": "Date",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "days",
            "required": true,
            "schema": {
              "title": "Days",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddDaysResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid parameter"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown market"
          }
        },
        "summary": "Move a date by n trading days (negative goes back) on every listed market"
      }
    },
