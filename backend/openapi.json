        "title": "Market",
        "type": "object"
      },
      "MarketList": {
        "items": {
          "$ref": "#/components/schemas/Market"
        },
        "title": "MarketList",
        "type": "array"
      },
      "OverlapResponse": {
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "days": {
            "items": {
              "format": "date",
              "type": "string"
            },
            "title": "Days",
            "type": "array"
          },
          "end": {
            "format": "date",
            "title": "End",
            "type": "string"
          },
          "markets": {
            "items": {
              "type": "string"
            },
            "title": "Markets",
            "type": "array"
          },
          "start": {
            "format": "date",
            "title": "Start",
