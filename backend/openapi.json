              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "cycle",
            "required": true,
            "schema": {
              "maximum": 10,
              "minimum": 0,
              "title": "Cycle",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
