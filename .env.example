# Copy to .env for docker compose. Use your own values; .env is never committed.
MYSQL_USER=marketclock
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# For running the API and tests on the host against the Compose services.
MARKETCLOCK_ENV=dev
DATABASE_URL=mysql+pymysql://marketclock:change-me@127.0.0.1:3306/marketclock?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://marketclock:change-me@127.0.0.1:3306/marketclock_test?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

# Requests a minute per client on /api/v1 (0 turns the limit off).
RATE_LIMIT_PER_MINUTE=120
